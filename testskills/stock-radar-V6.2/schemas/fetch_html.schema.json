{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/stock-radar/fetch_html.schema.json",
  "title": "Stock Radar fetch_html (HTML render data layer)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "code",
    "fetched_at",
    "source",
    "kline",
    "ma_overlay",
    "fund_flow",
    "annotations",
    "overlays",
    "benchmark_sector_fund_flow"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.4.2" },
    "code": { "type": "string", "pattern": "^[0-9]{6}$" },
    "fetched_at": { "type": "string", "minLength": 10 },
    "source": { "type": "string", "minLength": 3 },
    "kline": { "$ref": "#/$defs/kline_block" },
    "ma_overlay": { "$ref": "#/$defs/ma_overlay_block" },
    "fund_flow": { "$ref": "#/$defs/fund_flow_block" },
    "annotations": {
      "oneOf": [{ "$ref": "#/$defs/annotations_block" }, { "type": "null" }]
    },
    "overlays": { "$ref": "#/$defs/overlays_block" },
    "benchmark_sector_fund_flow": { "$ref": "#/$defs/benchmark_sector_fund_flow_block" }
  },
  "$defs": {
    "reason_code_kline": {
      "type": "string",
      "enum": [
        "IPO_SHORT_HISTORY",
        "SUSPENDED",
        "FETCH_FAILED",
        "INSUFFICIENT_BARS"
      ]
    },
    "reason_code_fund": {
      "type": "string",
      "enum": [
        "LAG_EXCEEDS_THRESHOLD",
        "API_STALE",
        "FETCH_FAILED",
        "EMPTY",
        "CONNECTION_ERROR",
        "PROXY_BLOCKED"
      ]
    },
    "kline_bar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "open", "high", "low", "close", "amount_lots"],
      "properties": {
        "date": { "type": "string", "minLength": 8 },
        "open": { "type": "number" },
        "high": { "type": "number" },
        "low": { "type": "number" },
        "close": { "type": "number" },
        "amount_lots": { "type": "number", "minimum": 0 }
      }
    },
    "kline_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_code", "reason", "bars_available", "bars_requested", "series"],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "partial", "unavailable"] },
        "reason_code": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "bars_available": { "type": "integer", "minimum": 0, "maximum": 60 },
        "bars_requested": { "type": "integer", "const": 60 },
        "series": {
          "type": "array",
          "maxItems": 60,
          "items": { "$ref": "#/$defs/kline_bar" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "unavailable" } }, "required": ["status"] },
          "then": {
            "properties": {
              "bars_available": { "const": 0 },
              "series": { "maxItems": 0 },
              "reason_code": { "$ref": "#/$defs/reason_code_kline" }
            },
            "required": ["reason"]
          }
        },
        {
          "if": { "properties": { "status": { "const": "partial" } }, "required": ["status"] },
          "then": {
            "properties": {
              "bars_available": { "type": "integer", "minimum": 5, "maximum": 59 },
              "reason_code": { "$ref": "#/$defs/reason_code_kline" }
            },
            "required": ["reason"]
          }
        },
        {
          "if": { "properties": { "status": { "const": "ok" } }, "required": ["status"] },
          "then": {
            "properties": {
              "bars_available": { "const": 60 },
              "series": { "minItems": 60, "maxItems": 60 },
              "reason_code": { "const": null },
              "reason": { "const": null }
            }
          }
        }
      ]
    },
    "ma_value": { "type": ["number", "null"] },
    "ma_overlay_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ma5", "ma20", "ma60"],
      "properties": {
        "ma5": { "type": "array", "items": { "$ref": "#/$defs/ma_value" } },
        "ma20": { "type": "array", "items": { "$ref": "#/$defs/ma_value" } },
        "ma60": { "type": "array", "items": { "$ref": "#/$defs/ma_value" } }
      }
    },
    "fund_flow_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "main_net_inflow", "is_net_in"],
      "properties": {
        "date": { "type": "string", "minLength": 8 },
        "main_net_inflow": { "type": "number" },
        "main_net_pct": { "type": ["number", "null"] },
        "is_net_in": { "type": "boolean" }
      }
    },
    "fund_flow_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_code",
        "reason",
        "as_of_date",
        "reference_date",
        "lag_trading_days",
        "series"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "stale", "error"] },
        "reason_code": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "as_of_date": { "type": ["string", "null"] },
        "reference_date": { "type": ["string", "null"] },
        "lag_trading_days": { "type": ["integer", "null"] },
        "series": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/fund_flow_row" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "error" } }, "required": ["status"] },
          "then": {
            "properties": {
              "series": { "maxItems": 0 },
              "reason_code": { "$ref": "#/$defs/reason_code_fund" }
            },
            "required": ["reason"]
          }
        },
        {
          "if": { "properties": { "status": { "const": "stale" } }, "required": ["status"] },
          "then": {
            "properties": {
              "series": { "minItems": 1 },
              "reason_code": { "enum": ["LAG_EXCEEDS_THRESHOLD", "API_STALE"] }
            },
            "required": ["reason", "as_of_date", "reference_date", "lag_trading_days"]
          }
        },
        {
          "if": { "properties": { "status": { "const": "ok" } }, "required": ["status"] },
          "then": {
            "properties": {
              "series": { "minItems": 1 },
              "reason_code": { "const": null },
              "reason": { "const": null }
            },
            "required": ["as_of_date", "reference_date", "lag_trading_days"]
          }
        }
      ]
    },
    "annotations_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ma_alignment",
        "trend_strength",
        "breakout_60d_high",
        "broke_60d_low",
        "near_60d_high_pct",
        "near_60d_low_pct",
        "volume_vs_20d",
        "change_20d_pct",
        "change_60d_pct"
      ],
      "properties": {
        "ma_alignment": {
          "type": "string",
          "enum": ["bullish_stack", "bearish_stack", "mixed"]
        },
        "trend_strength": {
          "type": "string",
          "enum": ["upward", "downward", "sideways"]
        },
        "breakout_60d_high": { "type": "boolean" },
        "broke_60d_low": { "type": "boolean" },
        "near_60d_high_pct": { "type": ["number", "null"] },
        "near_60d_low_pct": { "type": ["number", "null"] },
        "volume_vs_20d": {
          "type": "string",
          "enum": ["elevated", "normal", "subdued"]
        },
        "change_20d_pct": { "type": "number" },
        "change_60d_pct": { "type": "number" }
      }
    },
    "overlay_index_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "status", "pct"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["ok", "error"] },
        "pct": {
          "type": "array",
          "items": { "type": ["number", "null"] }
        },
        "last_close": { "type": ["number", "null"] }
      }
    },
    "overlay_sector_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "status", "pct"],
      "properties": {
        "code": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["ok", "skipped", "error"] },
        "pct": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "items": { "type": ["number", "null"] }
            }
          ]
        }
      }
    },
    "overlays_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "anchor", "dates", "stock_pct", "sh_index", "sector"],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "partial", "unavailable"] },
        "reason": { "type": ["string", "null"] },
        "anchor": { "type": "string", "const": "first_bar_close" },
        "dates": {
          "type": "array",
          "maxItems": 60,
          "items": { "type": "string", "minLength": 8 }
        },
        "stock_pct": {
          "type": "array",
          "maxItems": 60,
          "items": { "type": ["number", "null"] }
        },
        "overlay_stale_note": { "type": ["string", "null"] },
        "sh_index": { "$ref": "#/$defs/overlay_index_block" },
        "sector": { "$ref": "#/$defs/overlay_sector_block" }
      }
    },
    "benchmark_sector_fund_flow_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_code",
        "reason",
        "sector_name",
        "matched_name",
        "as_of_date",
        "reference_date",
        "lag_trading_days",
        "series"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok", "stale", "error", "placeholder"]
        },
        "reason_code": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "requested_name": { "type": ["string", "null"] },
        "sector_name": { "type": ["string", "null"] },
        "matched_name": { "type": ["string", "null"] },
        "as_of_date": { "type": ["string", "null"] },
        "reference_date": { "type": ["string", "null"] },
        "lag_trading_days": { "type": ["integer", "null"] },
        "source": { "type": ["string", "null"] },
        "series": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/fund_flow_row" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "error" } }, "required": ["status"] },
          "then": {
            "properties": {
              "series": { "maxItems": 0 },
              "reason_code": { "$ref": "#/$defs/reason_code_fund" }
            },
            "required": ["reason"]
          }
        },
        {
          "if": { "properties": { "status": { "const": "placeholder" } }, "required": ["status"] },
          "then": {
            "properties": { "series": { "maxItems": 0 } },
            "required": ["reason"]
          }
        },
        {
          "if": { "properties": { "status": { "const": "stale" } }, "required": ["status"] },
          "then": {
            "properties": {
              "series": { "minItems": 1 },
              "reason_code": { "enum": ["LAG_EXCEEDS_THRESHOLD", "API_STALE"] }
            },
            "required": ["reason", "as_of_date", "reference_date", "lag_trading_days"]
          }
        },
        {
          "if": { "properties": { "status": { "const": "ok" } }, "required": ["status"] },
          "then": {
            "properties": {
              "series": { "minItems": 1 },
              "reason_code": { "const": null },
              "reason": { "const": null }
            },
            "required": ["as_of_date", "reference_date", "lag_trading_days"]
          }
        }
      ]
    }
  }
}
