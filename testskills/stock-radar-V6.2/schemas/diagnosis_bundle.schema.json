{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/stock-radar/diagnosis_bundle.schema.json",
  "title": "Stock Radar Diagnosis Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meta", "judgment", "narrative", "judgments_j", "provenance"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.1.0", "1.2.0", "1.2.1"]
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "diagnosis_at", "data_as_of", "quote_mode", "price", "change_pct", "title_context"],
      "properties": {
        "code": { "type": "string", "pattern": "^[0-9]{6}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 32 },
        "diagnosis_at": { "type": "string", "minLength": 10 },
        "data_as_of": { "type": "string", "minLength": 4, "maxLength": 32 },
        "quote_mode": { "type": "string", "enum": ["intraday", "close"] },
        "price": { "type": "number", "exclusiveMinimum": 0 },
        "change_pct": { "type": "number" },
        "title_context": { "type": "string", "minLength": 4, "maxLength": 80 },
        "benchmark_sector": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 32 },
                "index_code": {
                  "type": ["string", "null"],
                  "pattern": "^BK[0-9]+$"
                }
              }
            }
          ]
        }
      }
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_primary",
        "state_display",
        "risk_tone",
        "core_dimensions",
        "secondary_dimensions",
        "technical_evolution"
      ],
      "properties": {
        "state_primary": {
          "type": "string",
          "enum": [
            "个股异动态",
            "板块共振态",
            "活跃热点态",
            "阶段切换态",
            "平静无驱动态"
          ]
        },
        "state_display": { "type": "string", "minLength": 4, "maxLength": 120 },
        "state_evolution": { "type": "string", "maxLength": 80 },
        "risk_tone": { "type": "string", "enum": ["加剧", "缓和", "持平"] },
        "core_dimensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dimension_key" }
        },
        "secondary_dimensions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dimension_key" }
        },
        "technical_evolution": { "type": "boolean" }
      }
    },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary_hook", "client_brief", "dimensions"],
      "properties": {
        "summary_hook": { "type": "string", "minLength": 40, "maxLength": 130 },
        "summary_hook_display": {
          "type": "string",
          "minLength": 30,
          "maxLength": 110,
          "description": "HTML-only summary without core risk clause; format_im ignores"
        },
        "client_brief": { "type": "string", "minLength": 50, "maxLength": 130 },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "基本面",
            "技术面",
            "资金面",
            "消息面",
            "概念 / 产业链",
            "市场环境"
          ],
          "properties": {
            "基本面": { "$ref": "#/$defs/dimension_block" },
            "技术面": { "$ref": "#/$defs/dimension_block" },
            "资金面": { "$ref": "#/$defs/dimension_block" },
            "消息面": { "$ref": "#/$defs/dimension_block" },
            "概念 / 产业链": { "$ref": "#/$defs/dimension_block" },
            "市场环境": { "$ref": "#/$defs/dimension_block" }
          }
        }
      }
    },
    "judgments_j": {
      "type": "object",
      "additionalProperties": false,
      "required": ["j1", "j2", "j3", "j3_consensus", "j4", "j5"],
      "properties": {
        "j1": { "type": "string", "minLength": 4, "maxLength": 40 },
        "j2": { "type": "string", "minLength": 4, "maxLength": 40 },
        "j3": { "type": "string", "minLength": 4, "maxLength": 40 },
        "j3_consensus": {
          "type": "string",
          "enum": ["共识深化", "共识退潮", "阶段持平"]
        },
        "j4": { "type": "string", "minLength": 4, "maxLength": 40 },
        "j5": { "type": "string", "minLength": 4, "maxLength": 60 }
      }
    },
    "judgments_j_expanded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["j1", "j2", "j3", "j4", "j5"],
      "properties": {
        "j1": { "$ref": "#/$defs/j_expanded_block" },
        "j2": { "$ref": "#/$defs/j_expanded_block" },
        "j3": { "$ref": "#/$defs/j_expanded_block" },
        "j4": { "$ref": "#/$defs/j_expanded_block" },
        "j5": { "$ref": "#/$defs/j_expanded_j5" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_notes", "disclaimer"],
      "properties": {
        "data_notes": { "type": "string", "minLength": 4, "maxLength": 300 },
        "fetch_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["fund_flow_error", "info_error"]
          },
          "uniqueItems": true
        },
        "disclaimer": {
          "type": "string",
          "const": "以上分析基于公开数据，仅供投顾内部参考，不构成投资建议；本文不涉及具体买卖点位与目标价；最终投资决策需结合客户风险承受能力与投顾独立判断。"
        }
      }
    },
    "fetch": { "type": "object" },
    "fetch_html": { "$ref": "fetch_html.schema.json" }
  },
  "$defs": {
    "dimension_key": {
      "type": "string",
      "enum": [
        "基本面",
        "技术面",
        "资金面",
        "消息面",
        "概念 / 产业链",
        "市场环境"
      ]
    },
    "dimension_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "conclusion", "data_bullets", "interpretation"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["core", "secondary", "secondary_technical"]
        },
        "conclusion": { "type": "string", "maxLength": 60 },
        "data_bullets": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string", "maxLength": 80 }
        },
        "interpretation": { "type": "string", "maxLength": 80 },
        "html_expanded": { "$ref": "#/$defs/html_expanded_block" }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "secondary" } }, "required": ["role"] },
          "then": {
            "required": ["html_expanded"],
            "properties": {
              "conclusion": { "const": "非当前主导。" },
              "data_bullets": { "maxItems": 0 },
              "interpretation": { "const": "不作交易参考。" }
            }
          }
        },
        {
          "if": { "properties": { "role": { "const": "secondary_technical" } }, "required": ["role"] },
          "then": {
            "properties": {
              "data_bullets": { "minItems": 1, "maxItems": 2 },
              "html_expanded": false
            }
          }
        },
        {
          "if": { "properties": { "role": { "const": "core" } }, "required": ["role"] },
          "then": {
            "properties": {
              "data_bullets": { "minItems": 1, "maxItems": 3 },
              "interpretation": { "minLength": 4 },
              "html_expanded": false
            }
          }
        }
      ]
    },
    "html_expanded_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclusion", "data_bullets", "interpretation"],
      "properties": {
        "conclusion": { "type": "string", "minLength": 4, "maxLength": 120 },
        "data_bullets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 4, "maxLength": 120 }
        },
        "interpretation": { "type": "string", "minLength": 4, "maxLength": 200 }
      }
    },
    "j_expanded_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "conclusion"],
      "properties": {
        "headline": { "type": "string", "minLength": 4, "maxLength": 24 },
        "conclusion": { "type": "string", "minLength": 4, "maxLength": 400 },
        "counter_examples": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string", "minLength": 4, "maxLength": 120 }
        },
        "key_rhythm": { "type": "string", "maxLength": 200 },
        "footnote": { "type": "string", "maxLength": 200 }
      }
    },
    "j_expanded_j5": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risks"],
      "properties": {
        "headline": { "type": "string", "maxLength": 24 },
        "conclusion": { "type": "string", "maxLength": 200 },
        "risks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/j_risk_item" }
        }
      }
    },
    "j_risk_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "level", "text"],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "估值风险",
            "主线切换风险",
            "商誉应收风险",
            "股东减持解禁",
            "流动性风险",
            "合规风险",
            "政策反转风险",
            "个股专属风险"
          ]
        },
        "level": {
          "type": "string",
          "enum": ["高", "中", "低", "未发现"]
        },
        "text": { "type": "string", "minLength": 2, "maxLength": 120 }
      }
    }
  }
}
