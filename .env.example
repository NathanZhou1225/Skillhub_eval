# SkillHub 评估系统 — 环境变量模板
# 用法：复制为 .env 后填入真实值（.env 已在 .gitignore 中，勿提交密钥）
#
#   cp .env.example .env        # Linux / macOS
#   copy .env.example .env      # Windows
#
# 修改 .env 后须重启 `skillhub-eval serve`。

# ── LLM 评审模型（双模型交叉验证，live 模式必填）────────────────────────────

# DeepSeek — 评审 Provider A
# 申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# Gemini — 评审 Provider B（OpenAI 兼容端点）
# 申请：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash

# ── 存储路径 ─────────────────────────────────────────────────────────────────

# SQLite 评估记录库（运行时自动创建父目录）
EVAL_DB_PATH=data/skillhub_eval.db

# 对话式评估上传材料的暂存目录（ZIP bootstrap 解压位置）
STAGING_ROOT=data/staging

# ── 评估协议版本（一般保持默认）──────────────────────────────────────────────

EVAL_LLM_MODE=live
RUBRIC_VERSION=v1.2
PROMPT_VERSION=review-agent-v0.2

# Demo / 开发开关 ──────────────────────────────────────────────────────────

# 对话 UI 是否允许「本地路径」引导 Skill 包（正式环境保持 false，仅 Demo 设 true）
SKILLHUB_DEMO_LOCAL_REF=false

# ── 本地 Agent 执行桥（W8）— 改后须重启 serve ─────────────────────────────
# 默认 sample_io；设为 local 时由本机 CLI agent 真跑（须 claude/codex/cursor-agent 在 PATH）
# EXEC_SOURCE=local
# EXEC_AGENT=claude
# EXEC_CONCURRENCY=2
# Demo 可先关 consent gate；正式环境保持 true
# EXEC_CONSENT_REQUIRED=false

# ── 超时（秒）— 按环境调参，改后须重启 serve ────────────────────────────────
# 代码默认值：provider 90/120；judge WORKFLOW 600/600/900；local agent 1800/2400/5400
# 本地 Demo 推荐（长链路、本地 Agent + 多 case）：见下方注释块

# 单次 LLM 评审调用超时（低/中风险 Skill）
PROVIDER_CALL_TIMEOUT_S=300

# 单次 LLM 评审调用超时（高风险 Skill）
PROVIDER_CALL_TIMEOUT_HIGH_RISK_S=300

# 双模型评审阶段超时（model_judging → 出报告；不含本地 Agent case_executing）
WORKFLOW_TIMEOUT_LOW_S=600
WORKFLOW_TIMEOUT_MEDIUM_S=600
WORKFLOW_TIMEOUT_HIGH_S=1200

# 本地 Agent 真跑阶段超时（case_executing；与 WORKFLOW_* 分开计时）
LOCAL_AGENT_WORKFLOW_TIMEOUT_LOW_S=1800
LOCAL_AGENT_WORKFLOW_TIMEOUT_MEDIUM_S=2400
LOCAL_AGENT_WORKFLOW_TIMEOUT_HIGH_S=7200

# 双模型分歧合成（divergence brief）单次调用超时
DIVERGENCE_SYNTHESIS_TIMEOUT_S=300
